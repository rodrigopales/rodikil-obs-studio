OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=sua_senha_aqui

# Opcional — URL do chat popout do YouTube usada pelo Overlay_ChatFeed (muda a cada live):
# YOUTUBE_CHAT_URL=https://www.youtube.com/live_chat?is_popout=1&v=ID_DA_LIVE

# ID do microfone principal (Fifine). Liste com: python scripts/test_connection.py --devices
MIC_DEVICE_ID=

# LivePix (doações via Pix) — copie os links dos widgets no painel do LivePix. São privados: só no .env.
# LIVEPIX_ALERTA_URL=
# LIVEPIX_QRCODE_URL=

# Assistente da live (scripts/assistente_live.py): canal para achar a live atual e ffmpeg para a versão vertical.
# YOUTUBE_CANAL=@RODIKIL
# FFMPEG=C:\caminho\para\ffmpeg.exe
